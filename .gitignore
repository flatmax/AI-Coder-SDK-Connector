# Python bytecode and build artefacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# AIC⚡DC runtime state (per-repo working directory).
# `.aic-dc/` is the current name. The two legacy entries are kept so a
# checkout that still holds state from an earlier name doesn't suddenly
# start showing 30MB of session JSONL as untracked.
# See src/aic_dc/config.py:_AIC_DC_DIR.
.aic-dc/
.ac-dc4/
.ac-dc/

# Node / webapp build output
node_modules/
webapp/node_modules/
webapp/dist/

# Environments
.venv/
venv/
.env

# Logs
*.log

# uv.lock is committed: the release workflow installs from it with
# `uv sync --frozen` for reproducible, cross-platform builds.

# Editor / tooling scratch directories
.aicoder/
safeZone/
